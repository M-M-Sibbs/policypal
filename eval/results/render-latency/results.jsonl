{"id": "Q01", "category": "direct", "question": "How many unused PTO days can I carry over into the next year?", "should_refuse": false, "http_status": 200, "status": "answered", "refused": false, "behavior_pass": true, "answer": "Up to 5 unused days of PTO may be carried over into the next calendar year. [1]", "gold_answer": "Up to 5 days, used by 31 March.", "gold_doc_ids": ["POL-02"], "cited_docs": ["POL-02"], "citations": [{"id": 1, "ref": 1, "chunk_id": "POL-02-v1.0-s09-c00", "document_id": "POL-02", "doc_id": "POL-02", "document_version": "1.0", "title": "Paid Time Off (PTO)", "section": "Carry-over", "page_start": null, "page_end": null, "snippet": "Up to 5 unused days of PTO may be carried over into the next calendar year. Carried-over days must be used by 31 March of that year.", "source_url": "/sources/POL-02#carry-over", "url": "/sources/POL-02#carry-over"}], "citation_valid": true, "partial_match": true, "citation_correct": true, "grounded": true, "lexical_support": 1.0, "grounding_method": "lexical-proxy", "provider": "extractive:offline", "best_similarity": 0.8328, "latency_ms": 4474.3, "server_latency_ms": 3410}
