{"id": "Q01", "category": "direct", "question": "How many unused PTO days can I carry over into next year?", "gold_answer": "Up to 5 days, used by 31 March.", "gold_facts": ["5 unused days", "up to 5", "five"], "gold_doc_ids": ["POL-02"], "gold_section": "Carry-over", "should_refuse": false, "expected_behavior": "answer_with_citations", "required_answer_groups": [["5", "five"], ["carry", "carried"]], "required_evidence_groups": [["5 unused days"], ["carried over"], ["31 March"]], "http_status": 200, "status": "answered", "answer": "Up to 5 unused PTO days may be carried over into the next calendar year, and any carried\u2011over days must be used by 31\u202fMarch of that year. [1] If you were unable to take PTO because of sickness or parental leave, you may carry over all unused days, which must be used within 12\u202fmonths of your return to work. [2]", "refused": false, "citations": [{"id": 1, "ref": 1, "chunk_id": "POL-02-v1.0-s09-c00", "document_id": "POL-02", "doc_id": "POL-02", "document_version": "1.0", "title": "Paid Time Off (PTO)", "section": "Carry-over", "page_start": null, "page_end": null, "snippet": "Up to 5 unused days of PTO may be carried over into the next calendar year. Carried-over days must be used by 31 March of that year.\n\u2026\nCarried-over days must be used by 31 March of that year. Any carried-over days not used by 31 March are forfeited.", "snippet_truncated": false, "source_url": "/sources/POL-02#carry-over", "url": "/sources/POL-02#carry-over"}, {"id": 2, "ref": 2, "chunk_id": "POL-02-v1.0-s10-c00", "document_id": "POL-02", "doc_id": "POL-02", "document_version": "1.0", "title": "Paid Time Off (PTO)", "section": "Exceptions to Carry-over", "page_start": null, "page_end": null, "snippet": "If you were unable to take PTO because of sickness or parental leave, you may carry over all unused days. These days must be used within 12 months of your return to work.", "snippet_truncated": false, "source_url": "/sources/POL-02#exceptions-to-carry-over", "url": "/sources/POL-02#exceptions-to-carry-over"}], "cited_docs": ["POL-02"], "provider": "groq:openai/gpt-oss-20b", "generation_mode": "llm", "provider_failures": [], "corpus_version": "v1-2a44e4aa53", "citation_format_valid": true, "snippet_verbatim": true, "answer_relevance_proxy": true, "evidence_complete_proxy": true, "citation_correct_proxy": true, "displayed_support_proxy": true, "displayed_lexical_support": 1.0, "full_passage_support_proxy": true, "behavior_pass": true, "strict_llm_pass": true, "automated_pass": true, "semantic_correctness": "human_review_required", "server_latency_ms": 2089, "latency_ms": 2110.9, "judge_supported": null}
{"id": "Q03", "category": "direct", "question": "How many floating holidays do employees get each year?", "gold_answer": "2 floating holidays per year.", "gold_facts": ["2 floating", "two floating"], "gold_doc_ids": ["POL-03"], "gold_section": "Floating Holidays", "should_refuse": false, "expected_behavior": "answer_with_citations", "required_answer_groups": [["2", "two"], ["floating"]], "required_evidence_groups": [["2 floating", "two floating"], ["year"]], "http_status": 200, "status": "answered", "answer": "Employees receive two floating holidays per calendar year, unless they join after 30\u202fJune, in which case they receive one floating holiday for their first calendar year. [1] [2]", "refused": false, "citations": [{"id": 1, "ref": 1, "chunk_id": "POL-03-v1.0-s04-c00", "document_id": "POL-03", "doc_id": "POL-03", "document_version": "1.0", "title": "Public Holidays", "section": "Floating Holidays", "page_start": null, "page_end": null, "snippet": "Each employee receives 2 floating holidays per calendar year. Floating holidays let employees mark religious, cultural or personal days that are not on the company list.", "snippet_truncated": false, "source_url": "/sources/POL-03#floating-holidays", "url": "/sources/POL-03#floating-holidays"}, {"id": 2, "ref": 2, "chunk_id": "POL-03-v1.0-s06-c00", "document_id": "POL-03", "doc_id": "POL-03", "document_version": "1.0", "title": "Public Holidays", "section": "Rules for Floating Holidays", "page_start": null, "page_end": null, "snippet": "New employees who join after 30 June receive 1 floating holiday for their first calendar year instead of 2.", "snippet_truncated": false, "source_url": "/sources/POL-03#rules-for-floating-holidays", "url": "/sources/POL-03#rules-for-floating-holidays"}], "cited_docs": ["POL-03"], "provider": "groq:openai/gpt-oss-20b", "generation_mode": "llm", "provider_failures": [], "corpus_version": "v1-2a44e4aa53", "citation_format_valid": true, "snippet_verbatim": true, "answer_relevance_proxy"