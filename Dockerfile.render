# Lightweight image for Render's free plan (512 MB RAM).
#
# No PyTorch or sentence-transformers: retrieval uses the built-in hash
# embedder without re-ranking, and answers still come from the Groq LLM.
# For the full semantic pipeline use the main Dockerfile on a plan with at
# least 2 GB RAM (e.g. Render Standard or Railway).

# ---- Stage 1: build the React frontend ---------------------------------------
FROM node:22-slim AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ---- Stage 2: Flask API + RAG pipeline ---------------------------------------
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ANONYMIZED_TELEMETRY=False \
    EMBED_BACKEND=hash \
    RERANK=0
WORKDIR /app

COPY requirements.txt .
RUN grep -v "sentence-transformers" requirements.txt > requirements-slim.txt \
    && pip install -r requirements-slim.txt

COPY app/ app/
COPY data/ data/
COPY scripts/ scripts/
COPY --from=frontend /fe/dist frontend/dist

# Build the Chroma index into the image so the service starts ready.
RUN python -m app.ingest

EXPOSE 10000
CMD ["sh", "-c", "PRELOAD_PIPELINE=1 exec gunicorn app:app --bind 0.0.0.0:${PORT:-10000} --workers 1 --threads 4 --timeout 120 --access-logfile -"]
