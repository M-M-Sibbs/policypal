# Copy to .env and fill in. Never commit .env.

# --- LLM (answer generation) ---
# groq | openrouter | openai | extractive (offline, no key, quotes passages)
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key
LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=            # only for a custom OpenAI-compatible endpoint
# Optional second provider used if the first one fails
# LLM_FALLBACK_PROVIDER=openrouter
# LLM_FALLBACK_API_KEY=your-openrouter-key
# LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_TIMEOUT_S=30
MAX_TOKENS=300

# --- Embeddings and retrieval ---
# sentence-transformers (BAAI/bge-small-en-v1.5) | hash (offline lexical baseline)
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK=1
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K=8
TOP_N=4
# Default 0.35 for sentence-transformers, 0.12 for hash. Calibrate with
# python scripts/calibrate_threshold.py and set the suggested value here.
# SCORE_THRESHOLD=0.35
CHUNK_TOKENS=500
CHUNK_OVERLAP=75
SEED=42

# --- Guardrails ---
MAX_QUESTION_CHARS=2000
ANSWER_WORD_TARGET=150
MAX_ANSWER_WORDS=250

# --- Server ---
# CHROMA_DIR=storage/chroma
# PRELOAD_PIPELINE=1      # load models at startup instead of on the first request
LOG_LEVEL=INFO
