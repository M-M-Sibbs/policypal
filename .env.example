# Copy to .env and fill in. Never commit .env.

# --- Storage ---
CHROMA_DIR=storage/chroma

# --- Embeddings and retrieval ---
# Final tested semantic configuration: Chroma ONNX MiniLM (no PyTorch required)
# Other supported backend: hash (offline lexical baseline)
EMBED_BACKEND=onnx
EMBED_MODEL=all-MiniLM-L6-v2-onnx

TOP_K=8
TOP_N=4
SCORE_THRESHOLD=0.30

# Final tested configuration does not use a cross-encoder reranker
RERANK=0

CHUNK_TOKENS=500
CHUNK_OVERLAP=75
SEED=42

# --- LLM (answer generation) ---
# groq | openrouter | openai | extractive
LLM_PROVIDER=groq
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b

# Leave blank unless using a custom OpenAI-compatible endpoint
LLM_BASE_URL=

LLM_TIMEOUT_S=30
LLM_TEMPERATURE=0
MAX_TOKENS=300

# PolicyPal also has a local extractive fallback in the application code
# for primary-provider failures.

# --- Guardrails ---
MAX_QUESTION_CHARS=2000
ANSWER_WORD_TARGET=150
MAX_ANSWER_WORDS=250

# --- Server ---
PRELOAD_PIPELINE=1
LOG_LEVEL=INFO

# --- Policy management (/admin page and /api/admin) ---
# Set a long random value to enable it; leave empty to disable.
ADMIN_TOKEN=
# Runtime uploads live here (not in data/policies), so "reset" restores the originals.
POLICY_UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=5
MAX_UPLOADED_DOCS=20
