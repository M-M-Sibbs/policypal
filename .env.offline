# Safe, committed offline configuration. No secrets required.
LLM_PROVIDER=extractive
EMBED_BACKEND=hash
RERANK=0
SCORE_THRESHOLD=0.12
CHROMA_DIR=storage/chroma-offline
PRELOAD_PIPELINE=1
LOG_LEVEL=INFO
# Local-only admin token for the /admin page in offline demos (server binds to 127.0.0.1).
# Never reuse this value on a public deployment.
ADMIN_TOKEN=offline-admin
POLICY_UPLOAD_DIR=storage/uploads-offline
